app_name=epusdt
app_uri=
log_level=info
http_access_log=false
sql_debug=false
http_listen=:8000

static_path=/static
runtime_root_path=/app/runtime

log_save_path=/app/logs
log_max_size=32
log_max_age=7
max_backups=3

# supported values: postgres,mysql,sqlite
db_type=postgres

# Token2U production PostgreSQL. Keep the real host and password only in the server .env.
postgres_host=
postgres_port=5411
postgres_user=token2u_epusdt
postgres_passwd=
postgres_database=epusdt
postgres_table_prefix=
postgres_max_idle_conns=10
postgres_max_open_conns=100
postgres_max_life_time=6

# sqlite primary database config
sqlite_database_filename=
sqlite_table_prefix=


# sqlite runtime store config
runtime_sqlite_filename=epusdt-runtime.db

# background scheduler config
queue_concurrency=10
queue_poll_interval_ms=1000
callback_retry_base_seconds=5

# Solana polling: request cap includes retries, transaction reads and health probes.
# These limits are shared within one process. Budget separately for other instances.
solana_scan_interval_seconds=15
solana_idle_scan_interval_seconds=300
solana_recent_activity_seconds=600
solana_scan_concurrency=2
solana_rpc_requests_per_second=2

# Shared public-first routing policy. Paid budget is soft: active payment work continues.
rpc_public_requests_per_second=2
rpc_paid_requests_per_second=5
rpc_public_timeout_seconds=5
rpc_paid_timeout_seconds=10
rpc_paid_requests_per_minute=120
rpc_stale_head_seconds=120
rpc_health_public_interval_seconds=60
rpc_health_paid_interval_seconds=900

# Independent paid review starts before expiry and continues for confirmations.
# These windows do not extend the payment deadline.
payment_review_window_seconds=120
payment_review_grace_seconds=600

# Address deposit discovery via GraphQL; RPC only verifies matching transactions.
# full_ledger is an explicit legacy rollback mode, not an automatic fallback.
aptos_scan_mode=address_events
aptos_indexer_url=https://api.mainnet.aptoslabs.com/v1/graphql
aptos_indexer_processor=fungible_asset_processor
aptos_indexer_api_key=
# Optional compatible GraphQL paid fallback; ordinary Aptos REST RPC URLs do not work here.
aptos_indexer_fallback_url=
aptos_indexer_fallback_api_key=

order_expiration_time=10
# 新 EPay 订单独占同网络/地址/资产，首次有效到账按实付结算（仅支持单实例）
epay_exclusive_addresses=true
order_notice_max_retry=0

api_rate_url=

# Set to true to re-run the install wizard on next startup.
install=true
